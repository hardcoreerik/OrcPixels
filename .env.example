# Optional environment variables (copy to .env or set in your shell). None are required.
# ORCPIXELS_ADDRESS=AA:BB:CC:DD:EE:FF   # CLI default sign (the web UI uses config/displays.json)
# ORCPIXELS_PYTHON=C:\path\to\python.exe  # launcher: use this Python instead of .venv
# ORCPIXELS_PORT=8765
# ORCPIXELS_TZ=us-pacific               # overrides the 'timezone' setting
# GITHUB_TOKEN=                         # raises the GitHub screen's rate limit
# X_BEARER_TOKEN=                       # enables the X screen
# USGS_API_KEY=                         # optional, raises USGS limits
